rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is user authenticated? ──────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ── Helper: safe role check (returns null if profile missing) ────────
    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    // ── Helper: get current user's employeeId from their profile ─────────
    function currentEmployeeId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId;
    }

    // ── Role predicates ──────────────────────────────────────────────────
    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'super_admin';
    }

    function isHRAdmin() {
      return isSignedIn() && (userRole() == 'hr_admin' || userRole() == 'super_admin');
    }

    // Any signed-in user whose profile has the given employeeId field
    function isOwnerById(employeeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.employeeId == employeeId;
    }

    // ── /users ───────────────────────────────────────────────────────────
    // SECURITY FIX [C1]: Removed blanket `allow create: if isSignedIn()`
    // which allowed ANY authenticated user to create user profiles with
    // arbitrary roles (e.g., super_admin). Now only:
    //   - Super admins can do anything
    //   - Users can read/update their own profile
    //   - HR admins can create new employee profiles
    //   - Users can create ONLY their own profile doc (self-registration)
    match /users/{userId} {
      allow read, write: if isSuperAdmin();
      allow read, update: if isSignedIn() && request.auth.uid == userId;
      allow create: if isHRAdmin();
      // User can create their own profile doc only (covers admin first-login
      // and secondary-app employee creation where the new user's UID == userId)
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    // ── /companies ───────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── /employees ───────────────────────────────────────────────────────
    // SECURITY FIX [C2]: Removed `|| isSignedIn()` from create rule.
    // Only HR admins can create employee records.
    // SECURITY FIX [M5]: Employee self-update restricted to safe fields only.
    // Employees cannot modify their own salary, department, designation,
    // status, employeeId, or employmentType.
    match /employees/{employeeId} {
      allow read:   if isHRAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isHRAdmin();
      allow update: if isHRAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid
            // Employees can update their profile, but cannot change these sensitive fields
            && request.resource.data.get('salary', null) == resource.data.get('salary', null)
            && request.resource.data.get('department', null) == resource.data.get('department', null)
            && request.resource.data.get('designation', null) == resource.data.get('designation', null)
            && request.resource.data.get('status', null) == resource.data.get('status', null)
            && request.resource.data.get('employeeId', null) == resource.data.get('employeeId', null)
            && request.resource.data.get('employmentType', null) == resource.data.get('employmentType', null));
      allow delete: if isSuperAdmin();
    }

    // ── /departments ─────────────────────────────────────────────────────
    match /departments/{deptId} {
      allow read:  if isSignedIn();
      allow write: if isHRAdmin();
    }

    // ── /attendance ──────────────────────────────────────────────────────
    // SECURITY FIX [C3]: Restricted create/update so employees can only
    // create/update their OWN attendance records. Previously any signed-in
    // user could mark anyone present/absent.
    match /attendance/{attId} {
      allow read:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.employeeId == currentEmployeeId());
      allow create:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && request.resource.data.employeeId == currentEmployeeId());
      allow update:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.employeeId == currentEmployeeId());
    }

    // ── /leaveRequests ───────────────────────────────────────────────────
    // SECURITY FIX: Restricted create so employees can only submit leave
    // requests for themselves (matching their own employeeId).
    match /leaveRequests/{leaveId} {
      allow read:
        if isHRAdmin()
        || (isSignedIn() && (
              resource == null
              || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
              || resource.data.employeeId == currentEmployeeId()
           ));
      allow create:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && request.resource.data.employeeId == currentEmployeeId());
      allow update:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.employeeId == currentEmployeeId()
            && resource.data.status == 'Pending');
    }

    // ── /leaveBalances ───────────────────────────────────────────────────
    match /leaveBalances/{balanceId} {
      allow read:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.employeeId == currentEmployeeId());
      allow write: if isHRAdmin();
    }

    // ── /payroll ─────────────────────────────────────────────────────────
    // SECURITY FIX: Allow employees to read their OWN payroll records
    // (needed for employee payslip view). Write remains admin-only.
    match /payroll/{payId} {
      allow read:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.employeeId == currentEmployeeId());
      allow write: if isHRAdmin();
    }

    // ── /payslips ────────────────────────────────────────────────────────
    match /payslips/{slipId} {
      allow read:
        if isHRAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && resource.data.employeeId == currentEmployeeId());
      allow write: if isHRAdmin();
    }

    // ── /documents ───────────────────────────────────────────────────────
    match /documents/{docId} {
      allow read:
        if isHRAdmin()
        || (isSignedIn() && (
              resource.data.visibility == 'Public'
              || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && resource.data.employeeId == currentEmployeeId())
           ));
      allow write: if isHRAdmin();
    }

    // ── /folders ─────────────────────────────────────────────────────────
    match /folders/{folderId} {
      allow read:  if isSignedIn();
      allow write: if isHRAdmin();
    }

    // ── /tasks ───────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Employee can read if EITHER assignedTo OR assigneeId matches their UID
      // (assignedTo is the canonical field; assigneeId is the legacy/alternate field)
      allow read:
        if isHRAdmin()
        || (isSignedIn() && (
              resource.data.assignedTo == request.auth.uid
              || resource.data.assigneeId == request.auth.uid
           ));
      allow create: if isHRAdmin();
      allow update:
        if isHRAdmin()
        || (isSignedIn() && (
              resource.data.assignedTo == request.auth.uid
              || resource.data.assigneeId == request.auth.uid
           ));
    }

    // ── /notices ─────────────────────────────────────────────────────────
    // Employees can read all notices and update ONLY the readBy field
    // (marking as read). They cannot modify title, description, or other fields.
    match /notices/{noticeId} {
      allow read:  if isSignedIn();
      allow create, delete: if isHRAdmin();
      allow update: if isHRAdmin() || (isSignedIn() && request.resource.data.title == resource.data.title && request.resource.data.description == resource.data.description);
    }

    // ── /notifications ───────────────────────────────────────────────────
    // SECURITY FIX [M3]: Notifications can only be created for valid targets.
    // Any authenticated user can create (needed for employee→admin task updates),
    // but read/update is restricted to the notification's target user.
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create:       if isSignedIn();
    }

    // ── /settings ────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read:  if isSignedIn();
      allow write: if isHRAdmin();
    }

    // ── /activityLogs ────────────────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read:   if isHRAdmin();
      allow create: if isSignedIn();
    }
  }
}
