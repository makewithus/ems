rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // SECURITY NOTE: getRole() uses Firebase Auth custom claims.
    // If custom claims are not set, this returns null and write access
    // will be denied. This is the SAFE default — block unless proven admin.
    function getRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && (getRole() == 'hr_admin' || getRole() == 'super_admin');
    }

    // SECURITY FIX [C6]: Write access restricted to admin roles.
    // Previously any signed-in user could upload/overwrite/delete files
    // in documents, employees, and company storage paths.
    match /documents/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /employees/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /payslips/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    
    match /avatars/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /company/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (getRole() == 'super_admin');
    }
  }
}
